# Site
NEXT_PUBLIC_SITE_URL=https://bitcoin-flagship.vercel.app
NEXT_PUBLIC_LIGHTNING_ADDRESS=tips@bitcoinflagship.org

# Lightning provider: mock | lnd | btcpayserver
LIGHTNING_PROVIDER=mock

# LND (REST API) — used when LIGHTNING_PROVIDER=lnd
# LND_HOST=http://localhost:8080
# LND_MACAROON=0201036c6e6432...
# LND_TLS_CERT=<base64 of tls.cert>

# BTCPay Server — used when LIGHTNING_PROVIDER=btcpayserver
# BTCPAY_URL=https://btcpay.yourdomain.com
# BTCPAY_API_KEY=<api key>
# BTCPAY_STORE_ID=<store id>

# Draft review gate. /learn/preview serves written-but-unpublished lessons as
# static HTML, so the text is in the build output and the URLs are guessable.
# Set both on the deployment to put HTTP basic auth in front of them. If they
# are unset the route is open in development and returns 404 in production, so
# a forgotten env var fails closed rather than publishing drafts.
# PREVIEW_BASIC_AUTH_USER=<reviewer>
# PREVIEW_BASIC_AUTH_PASSWORD=<long password>

# Supabase (Dashboard -> Project Settings -> API Keys). Without these the
# community wall serves sample content and /api/health reports "unconfigured".
# The schema comes from supabase/migrations, applied by supabase db push or by
# the Supabase GitHub integration.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>

# Server only. Never prefix this with NEXT_PUBLIC_: it bypasses row level
# security, and anything with that prefix is inlined into the browser bundle.
# SUPABASE_SERVICE_ROLE_KEY=<service role key>
